# RF Simulator base URL (RFD_Sim_PRD.md)
RF_SIMULATOR_URL=http://localhost:8001

# AI Engine base URL + paths (Dashboard_PRD.md section 32)
AI_ENGINE_URL=http://localhost:8002
AI_PREDICT_PATH=/api/v1/agent/predict
AI_FEEDBACK_PATH=/api/v1/agent/feedback
AI_REQUEST_TIMEOUT_S=1.5

# Observation window sent to the AI Engine (Dashboard_PRD.md section 9)
OBSERVATION_WINDOW=20
HISTORY_DISPLAY_LIMIT=200

# Fallback engine (Dashboard_PRD.md section 12/14)
FALLBACK_DIR=data/fallback
FALLBACK_RECORDS_PER_SCENARIO=250

# Persistence (Dashboard_PRD.md section 36)
RUNS_DIR=data/runs
PERSIST_RUNS=true

# Server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
CORS_ORIGINS=http://localhost:5173
